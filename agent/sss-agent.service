[Unit]
Description=Server Status Agent
After=syslog.target


[Service]
# Modify these two values and uncomment them if you have
# repos with lots of files and get an HTTP error 500 because
# of that
###
#LimitMEMLOCK=infinity
#LimitNOFILE=65535
Type=simple
# 关掉 Python 输出缓冲, journalctl -u sss-agent 才能实时看到日志
Environment=PYTHONUNBUFFERED=1
User=root
Group=root
WorkingDirectory=/opt/sss/agent/
# INTERVAL: 上报间隔(秒); PING_INTERVAL: 三网探测间隔(秒), 0 = 关闭探测
ExecStart=/usr/bin/python3 /opt/sss/agent/client-linux.py SERVER=sss_host USER=sss_user PASSWORD=sss_pass INTERVAL=5 PING_INTERVAL=30
Restart=always
#Environment=DEBUG=true

# Some distributions may not support these hardening directives. If you cannot start the service due
# to an unknown option, comment out the ones not supported by your version of systemd.
#ProtectSystem=full
#PrivateDevices=yes
#PrivateTmp=yes
#NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
